# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# In Docker Compose, host is 'postgres'. For local standalone development, host is 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cryoguard?schema=public

# Redis Connection
# In Docker Compose, host is 'redis'. For local standalone development, host is 'localhost'.
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=cryoguard_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=24h
SIMULATOR_API_KEY=cryoguard-sim-key-secret-999

# Demo Seed Credentials
SEED_ADMIN_PASSWORD=Admin@123456
SEED_STAFF_PASSWORD=Staff@123456

# Client Environment (Vite)
VITE_API_URL=http://localhost:4000/api
