# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# In Docker Compose, host is 'postgres'. For local standalone development, host is 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cryoguard?schema=public

# Redis Connection
# In Docker Compose, host is 'redis'. For local standalone development, host is 'localhost'.
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h
SIMULATOR_API_KEY=your_simulator_api_key_here

# Demo Seed Credentials
SEED_ADMIN_PASSWORD=your_seed_admin_password_here
SEED_STAFF_PASSWORD=your_seed_staff_password_here

# Client Environment (Vite)
VITE_API_URL=http://localhost:4000/api
