{
  "name": "cryoguard-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "CryoGuard Sensor Simulator",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "sim:normal": "tsx src/index.ts --scenario normal",
    "sim:temp-spike": "tsx src/index.ts --scenario temp-spike",
    "sim:low-level": "tsx src/index.ts --scenario low-level"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
